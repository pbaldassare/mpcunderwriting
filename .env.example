# Porta dev server Vite (usata da vite.config.ts e task workspace)
VITE_DEV_PORT=5175

# Client Supabase (pubblici: URL + anon/publishable key). Obbligatori nel build,
# altrimenti la pagina resta bianca con "Supabase non è configurato".
# In locale vanno nel file .env (non committato). Su Cloudflare Pages il build
# di produzione li legge da .env.production, già nel repo.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>
# VITE_SUPABASE_PROJECT_ID=<ref>
# VITE_APP_ENV=production

# Moonshot / Kimi (lettura documenti e assistenti IA). Solo secret Edge, MAI VITE_.
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k2.6

